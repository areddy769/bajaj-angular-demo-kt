# Server
PORT=3000

# SQLite database (relative to prisma/ folder, ./dev.db resolves to prisma/dev.db)
DATABASE_URL="file:./dev.db"

# JWT (change in real projects — demo secret only for local training)
JWT_SECRET=change-this-development-secret
JWT_EXPIRES_IN=1h

# Angular dev server
FRONTEND_URL=http://localhost:4200

# Node env
NODE_ENV=development
