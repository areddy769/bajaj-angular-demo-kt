{
  "info": {
    "name": "bajaj-angular-demo-api",
    "description": "Bajaj Angular Fresher Demo API — import, login (saves token), then call protected endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "customerId", "value": "1" },
    { "key": "userId", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data.token) { pm.collectionVariables.set('token', json.data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data.token) { pm.collectionVariables.set('token', json.data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"User@123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        { "name": "List Customers", "request": { "method": "GET", "url": "{{baseUrl}}/customers?page=1&limit=10" } },
        { "name": "Search Customers", "request": { "method": "GET", "url": "{{baseUrl}}/customers?search=rahul" } },
        { "name": "Filter Customers", "request": { "method": "GET", "url": "{{baseUrl}}/customers?status=ACTIVE&city=Mumbai&sortBy=firstName&sortOrder=asc" } },
        { "name": "Get Customer", "request": { "method": "GET", "url": "{{baseUrl}}/customers/{{customerId}}" } },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Rahul\",\n  \"lastName\": \"Sharma\",\n  \"email\": \"rahul.new@example.com\",\n  \"mobile\": \"9876543210\",\n  \"gender\": \"MALE\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"400001\",\n  \"customerType\": \"INDIVIDUAL\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/customers"
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Rahul\",\n  \"lastName\": \"Sharma\",\n  \"email\": \"rahul.new@example.com\",\n  \"mobile\": \"9876543210\",\n  \"gender\": \"MALE\",\n  \"city\": \"Pune\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"411001\",\n  \"customerType\": \"INDIVIDUAL\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/customers/{{customerId}}"
          }
        },
        { "name": "Delete Customer (ADMIN only)", "request": { "method": "DELETE", "url": "{{baseUrl}}/customers/{{customerId}}" } }
      ]
    },
    {
      "name": "Users (ADMIN only)",
      "item": [
        { "name": "List Users", "request": { "method": "GET", "url": "{{baseUrl}}/users?page=1&limit=10" } },
        { "name": "Get User", "request": { "method": "GET", "url": "{{baseUrl}}/users/{{userId}}" } },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"USER\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"John Updated\"\n}" },
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Update User Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"INACTIVE\"\n}" },
            "url": "{{baseUrl}}/users/{{userId}}/status"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        { "name": "Dashboard Summary", "request": { "method": "GET", "url": "{{baseUrl}}/dashboard/summary" } }
      ]
    }
  ]
}
